(c-include "../BOSS.h")
(define-c-struct BOSSExpression finalizer: freeBOSSExpression)
(define-c-struct BOSSSymbol finalizer: freeBOSSSymbol)
(define-c (free BOSSSymbol) symbolNameToNewBOSSSymbol ((const string)))
(define-c (free (const string)) bossSymbolToNewString ((const BOSSSymbol)))


(define-c (free BOSSExpression) boolToNewBOSSExpression ((const bool)))
(define-c (free BOSSExpression) charToNewBOSSExpression ((const int8_t)))
(define-c (free BOSSExpression) doubleToNewBOSSExpression ((const double)))
(define-c (free BOSSExpression) floatToNewBOSSExpression ((const float)))
(define-c (free BOSSExpression) intToNewBOSSExpression ((const int)))
(define-c (free BOSSExpression) longToNewBOSSExpression ((const long)))
(define-c (free BOSSExpression) stringToNewBOSSExpression ((const string)))
(define-c (free BOSSExpression) symbolNameToNewBOSSExpression ((const string)))

(define-c BOSSExpression newComplexBOSSExpression (BOSSSymbol long (array BOSSExpression)))

(define-c long getBOSSExpressionTypeID (BOSSExpression))

(define-c float getFloatValueFromBOSSExpression ((const BOSSExpression)))
(define-c bool getBoolValueFromBOSSExpression ((const BOSSExpression)))
(define-c int8_t getCharValueFromBOSSExpression ((const BOSSExpression)))
(define-c int getIntValueFromBOSSExpression ((const BOSSExpression)))
(define-c long getLongValueFromBOSSExpression ((const BOSSExpression)))
(define-c double getDoubleValueFromBOSSExpression ((const BOSSExpression)))
(define-c (free string) getNewStringValueFromBOSSExpression ((const BOSSExpression)))
(define-c (free (const string)) getNewSymbolNameFromBOSSExpression ((const BOSSExpression)))


(define-c (free BOSSSymbol) getHeadFromBOSSExpression ((const BOSSExpression)))
(define-c long getArgumentCountFromBOSSExpression ((const BOSSExpression)))
(c-declare "struct BOSSExpression* getArgumentFromBOSSExpressionArray(struct BOSSExpression** array, size_t index) {return array[index];}")
(define-c BOSSExpression getArgumentFromBOSSExpressionArray ((pointer BOSSExpression) long))
(define-c (pointer BOSSExpression) getArgumentsFromBOSSExpression ((const BOSSExpression)))
(define-c void freeBOSSArguments ((pointer BOSSExpression)))


(define-c (free BOSSExpression) BOSSEvaluate (BOSSExpression))



